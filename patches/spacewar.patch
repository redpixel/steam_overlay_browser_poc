+
+//-----------------------------------------------------------------------------
+// Purpose: Checks whether the overlay can show more than one web popup.
+//	"-now":   both calls in the same frame
+//	"-delay": popup #2 is requested 3s later, while popup #1 is (hopefully) still open
+// Watch whether #2 replaces #1, opens beside it, or is ignored, and how many
+// GameOverlayActivated_t events arrive (see overlay_browser_test.log).
+//-----------------------------------------------------------------------------
+void COverlayExamples::StartMultiPopupTest( const char *pchVariant )
+{
+	EActivateGameOverlayToWebPageMode eMode = strncmp( pchVariant, "modal", 5 ) == 0
+		? k_EActivateGameOverlayToWebPageMode_Modal : k_EActivateGameOverlayToWebPageMode_Default;
+	bool bDelay = strstr( pchVariant, "delay" ) != NULL;
+
+	LogBrowserTest( "[Multi] ---- start %s ----", pchVariant );
+	m_ulSecondPopupDueTick = 0;
+	StartBrowserTest( MakePopupURL( 1 ).c_str(), eMode );
+	if ( m_eBrowserTestState != k_EBrowserTestState_WaitingForOpen )
+		return;	// popup #1 was not requested
+
+	if ( bDelay )
+	{
+		m_ulSecondPopupDueTick = m_pGameEngine->GetGameTickCount() + 3000;
+	}
+	else
+	{
+		std::string strURL = MakePopupURL( 2 );
+		LogBrowserTest( "[Multi] popup #2: ActivateGameOverlayToWebPage( \"%s\" )", strURL.c_str() );
+		SteamFriends()->ActivateGameOverlayToWebPage( strURL.c_str(), eMode );
+	}
+}
+
+
+std::string COverlayExamples::MakePopupURL( int nPopup ) const
+{
+	std::string strURL = m_strBrowserTestURL;
+	size_t iFragment = strURL.find( '#' );
+	std::string strFragment;
+	if ( iFragment != std::string::npos )
+	{
+		strFragment = strURL.substr( iFragment );
+		strURL.erase( iFragment );
+	}
+	strURL += ( strURL.find( '?' ) == std::string::npos ) ? "?" : "&";
+	strURL += "popup=" + std::to_string( nPopup );
+	return strURL + strFragment;
+}
