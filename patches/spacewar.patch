-		bRet = GetMessage( &msg, m_hWnd, 0, 0 );
-		if( bRet != 0 && bRet != -1 )
-		{
-			TranslateMessage(&msg);
-			DispatchMessage(&msg);
-		}
+		if ( msg.message == WM_QUIT )
+			continue;	// WM_DESTROY already started Shutdown()
+
+		TranslateMessage(&msg);
+		DispatchMessage(&msg);
 	}
