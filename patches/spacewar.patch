+void COverlayExamples::RunBrowserTestFrame()
+{
+	// The game keeps running while the overlay has focus, so this fires while popup #1 is showing
+	if ( m_ulSecondPopupDueTick != 0 && m_pGameEngine->GetGameTickCount() >= m_ulSecondPopupDueTick )
+	{
+		m_ulSecondPopupDueTick = 0;
+		std::string strURL = MakePopupURL( 2 );
+		LogBrowserTest( "[Multi] popup #2 (state=%d): ActivateGameOverlayToWebPage( \"%s\" )", (int)m_eBrowserTestState, strURL.c_str() );
+		SteamFriends()->ActivateGameOverlayToWebPage( strURL.c_str(), m_eBrowserTestMode );
+	}
+
+	if ( m_eBrowserTestState != k_EBrowserTestState_WaitingForOpen )
+		return;
+
+	if ( m_pGameEngine->GetGameTickCount() - m_ulBrowserTestRequestTick > k_ulBrowserTestOpenTimeoutMS )
+	{
+		m_eBrowserTestState = k_EBrowserTestState_FailedToOpen;
+		LogBrowserTest( "FAILED: overlay did not activate within %llu ms (overlay disabled or not injected?)",
+			(unsigned long long)k_ulBrowserTestOpenTimeoutMS );
+	}
+}
+
+
+void COverlayExamples::OnGameOverlayActivated( GameOverlayActivated_t *pCallback )
+{
+	LogBrowserTest( "GameOverlayActivated_t: active=%d userInitiated=%d appID=%u",
+		(int)pCallback->m_bActive, (int)pCallback->m_bUserInitiated, pCallback->m_nAppID );
+
+	uint64 ulNow = m_pGameEngine->GetGameTickCount();
+
+	if ( pCallback->m_bActive )
+	{
+		if ( m_eBrowserTestState == k_EBrowserTestState_WaitingForOpen || m_eBrowserTestState == k_EBrowserTestState_FailedToOpen )
+		{
+			m_eBrowserTestState = k_EBrowserTestState_Open;
+			m_ulBrowserTestOpenTick = ulNow;
+			LogBrowserTest( "BROWSER OPENED (%llu ms after request)", (unsigned long long)( ulNow - m_ulBrowserTestRequestTick ) );
+		}
+	}
+	else
+	{
+		if ( m_eBrowserTestState == k_EBrowserTestState_Open )
+		{
+			m_eBrowserTestState = k_EBrowserTestState_Closed;
+			m_ulBrowserTestCloseTick = ulNow;
+			m_bBrowserTestClosedByUser = pCallback->m_bUserInitiated;
+			LogBrowserTest( "%s (open for %llu ms, userInitiated=%d)",
+				m_eBrowserTestMode == k_EActivateGameOverlayToWebPageMode_Modal ? "BROWSER CLOSED" : "OVERLAY HIDDEN (browser window may still be open)",
+				(unsigned long long)( ulNow - m_ulBrowserTestOpenTick ), (int)pCallback->m_bUserInitiated );
+		}
+	}
+}
+
+
+void COverlayExamples::OnOverlayBrowserProtocolNavigation( OverlayBrowserProtocolNavigation_t *pCallback )
+{
+	m_strBrowserTestLastProtocolURI = pCallback->rgchURI;
+	LogBrowserTest( "OverlayBrowserProtocolNavigation_t: %s", pCallback->rgchURI );
+}
