+void COverlayExamples::OpenBridgePopup()
+{
+#ifdef _WIN32
+	if ( !g_bOvbReady )
+	{
+		LogBrowserTest( "[OVB] not available: %s", m_strOvbStatus.c_str() );
+		return;
+	}
+	uint32_t unPopupId = 0;
+	int nRC = g_Ovb.OVB_OpenUrl( m_strOvbURL.c_str(), &unPopupId );
+	LogBrowserTest( "[OVB] OVB_OpenUrl( \"%s\" ) -> %d, popup %u", m_strOvbURL.c_str(), nRC, unPopupId );
+	if ( nRC == OVB_BRIDGE_OK )
+	{
+		m_unOvbLastPopup = unPopupId;
+		RefreshBridgeStatus();
+	}
+	else
+	{
+		// No last popup any more, so the per-frame status refresh does not hide this error
+		m_unOvbLastPopup = 0;
+		if ( nRC == OVB_BRIDGE_ERR_OVERLAY_DISABLED )
+			m_strOvbStatus = "Steam overlay is off: turn it on in Steam settings (or wait a few seconds after start)";
+		else
+			m_strOvbStatus = nRC == OVB_BRIDGE_ERR_OVERLAY ? "OFF: no Steam overlay" : "open failed (" + std::to_string( nRC ) + ")";
+	}
+	m_pMenu->Rebuild();
+#endif
+}
