+void COverlayExamples::PasteBrowserTestURLFromClipboard()
+{
+#ifdef _WIN32
+	if ( !OpenClipboard( NULL ) )
+	{
+		LogBrowserTest( "OpenClipboard failed" );
+		return;
+	}
+
+	std::string strURL;
+	if ( HANDLE hData = GetClipboardData( CF_UNICODETEXT ) )
+	{
+		if ( const wchar_t *pwchText = (const wchar_t *)GlobalLock( hData ) )
+		{
+			strURL = WideToUTF8( pwchText );
+			GlobalUnlock( hData );
+		}
+	}
+	CloseClipboard();
+
+	// only take the first line
+	size_t iNewline = strURL.find_first_of( "\r\n" );
+	if ( iNewline != std::string::npos )
+		strURL.erase( iNewline );
+
+	if ( strURL.empty() )
+		LogBrowserTest( "Clipboard has no text" );
+	else
+		SetBrowserTestURL( strURL );
+#endif
+}
