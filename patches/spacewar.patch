+
+// Status of the last popup, shown in the menu
+void COverlayExamples::RefreshBridgeStatus()
+{
+#ifdef _WIN32
+	if ( !g_bOvbReady || !m_unOvbLastPopup )
+		return;
+	OVB_PopupInfo info = {};
+	info.structSize = sizeof( info );
+	if ( g_Ovb.OVB_GetPopupInfo( m_unOvbLastPopup, &info ) != OVB_BRIDGE_OK )
+		return;
+	static const char *s_rgpchState[] = { "?", "waiting", "open", "closed" };
+	std::string strStatus = "popup " + std::to_string( m_unOvbLastPopup ) + ": " + s_rgpchState[info.state <= 3 ? info.state : 0];
+	if ( info.state == OVB_POPUP_CLOSED )
+		strStatus += std::string( " " ) + OvbReasonName( (int)info.closeReason );
+	if ( strStatus != m_strOvbStatus )
+	{
+		m_strOvbStatus = strStatus;
+		m_pMenu->Rebuild();
+	}
+#endif
+}
