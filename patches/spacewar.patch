+void COverlayExamples::DrawBrowserTestStatus()
+{
+	const char *pchState = "Idle";
+	DWORD dwColor = D3DCOLOR_ARGB( 255, 200, 200, 200 );
+	switch ( m_eBrowserTestState )
+	{
+	case k_EBrowserTestState_WaitingForOpen:	pchState = "Waiting for overlay...";	dwColor = D3DCOLOR_ARGB( 255, 255, 255, 0 ); break;
+	case k_EBrowserTestState_Open:				pchState = "OPEN";						dwColor = D3DCOLOR_ARGB( 255, 25, 200, 25 ); break;
+	case k_EBrowserTestState_Closed:			pchState = m_eBrowserTestMode == k_EActivateGameOverlayToWebPageMode_Modal ? "CLOSED" : "OVERLAY HIDDEN";
+												dwColor = D3DCOLOR_ARGB( 255, 255, 128, 0 ); break;
+	case k_EBrowserTestState_FailedToOpen:		pchState = "FAILED TO OPEN";			dwColor = D3DCOLOR_ARGB( 255, 255, 64, 64 ); break;
+	default: break;
+	}
+
+	char rgchLine1[512];
+	char rgchLine2[1200];
+	sprintf_safe( rgchLine1, "Browser test [%s]: %s   overlayEnabled=%d",
+		m_eBrowserTestMode == k_EActivateGameOverlayToWebPageMode_Modal ? "Modal" : "Default",
+		pchState, (int)SteamUtils()->IsOverlayEnabled() );
+
+	if ( m_eBrowserTestState == k_EBrowserTestState_Closed )
+	{
+		sprintf_safe( rgchLine2, "open %llu ms, closed by user=%d   protocol nav: %s",
+			(unsigned long long)( m_ulBrowserTestCloseTick - m_ulBrowserTestOpenTick ), (int)m_bBrowserTestClosedByUser,
+			m_strBrowserTestLastProtocolURI.empty() ? "-" : m_strBrowserTestLastProtocolURI.c_str() );
+	}
+	else
+	{
+		sprintf_safe( rgchLine2, "protocol nav: %s   (log: %s)",
+			m_strBrowserTestLastProtocolURI.empty() ? "-" : m_strBrowserTestLastProtocolURI.c_str(), k_pchBrowserTestLogFile );
+	}
+
+	const int32 nLineHeight = MENU_FONT_HEIGHT + MENU_ITEM_PADDING;
+	RECT rect;
+	rect.left = 10;
+	rect.right = m_pGameEngine->GetViewportWidth() - 10;
+	rect.bottom = m_pGameEngine->GetViewportHeight() - 10;
+	rect.top = rect.bottom - nLineHeight;
+	m_pGameEngine->BDrawString( g_hMenuFont, rect, D3DCOLOR_ARGB( 255, 200, 200, 200 ), TEXTPOS_LEFT|TEXTPOS_VCENTER, rgchLine2 );
+	rect.bottom = rect.top;
+	rect.top = rect.bottom - nLineHeight;
+	m_pGameEngine->BDrawString( g_hMenuFont, rect, dwColor, TEXTPOS_LEFT|TEXTPOS_VCENTER, rgchLine1 );
+}
