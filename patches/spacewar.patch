+void COverlayExamples::LogBrowserTest( const char *pchFormat, ... )
+{
+	char rgchMessage[2048];
+	va_list args;
+	va_start( args, pchFormat );
+	vsnprintf( rgchMessage, sizeof( rgchMessage ), pchFormat, args );
+	va_end( args );
+
+	char rgchLine[2200];
+	sprintf_safe( rgchLine, "[OverlayBrowserTest %llu] %s\n", (unsigned long long)m_pGameEngine->GetGameTickCount(), rgchMessage );
+
+	OutputDebugString( rgchLine );
+	printf( "%s", rgchLine );
+	fflush( stdout );
+
+	if ( FILE *file = fopen( k_pchBrowserTestLogFile, "at" ) )
+	{
+		fputs( rgchLine, file );
+		fclose( file );
+	}
+}
