+// First line of a text file, without surrounding whitespace or a UTF-8 BOM; strDefault when the
+// file is missing or the line is empty
+static std::string ReadFirstLine( const char *pchFile, const std::string &strDefault )
+{
+	std::string strLine;
+	if ( FILE *file = fopen( pchFile, "rt" ) )
+	{
+		char rgchLine[1024] = {};
+		if ( fgets( rgchLine, sizeof( rgchLine ), file ) )
+			strLine = rgchLine;
+		fclose( file );
+	}
+	strLine.erase( strLine.find_last_not_of( " \t\r\n" ) + 1 );
+	strLine.erase( 0, strLine.find_first_not_of( " \t\xEF\xBB\xBF" ) );
+	return strLine.empty() ? strDefault : strLine;
+}
