+//-----------------------------------------------------------------------------
+// Device ID: one UUID per machine and user, shared by every game and kept when a game is
+// uninstalled. Returned if the file exists, created otherwise.
+//  - Windows:              %LOCALAPPDATA%\OverlayBridge\device_id.txt
+//  - Proton / Wine (Deck): every game gets its own Wine prefix (compatdata/<appid>), so AppData
+//                          there is per game and can go away with it. The file goes to the Linux
+//                          home instead (Windows path from wine_get_dos_file_name, so no
+//                          fixed drive letter):
+//                          $XDG_DATA_HOME/OverlayBridge/device_id.txt, default ~/.local/share/OverlayBridge/device_id.txt
+//                          (the same place a native Linux build would use)
+// The file holds the UUID only (lowercase, 8-4-4-4-12). It is written to a temp file and then
+// moved into place without replacing, so two games starting at once end up with the same ID.
+//-----------------------------------------------------------------------------
+#ifdef _WIN32
+namespace
+{
+	const wchar_t *k_pwchDeviceIdFolder = L"OverlayBridge";
+	const wchar_t *k_pwchDeviceIdFile = L"device_id.txt";
+
+	std::string WideToUTF8( const wchar_t *pwch )
+	{
+		int cch = WideCharToMultiByte( CP_UTF8, 0, pwch, -1, NULL, 0, NULL, NULL );
+		std::string str( cch > 0 ? cch - 1 : 0, '\0' );
+		if ( cch > 1 )
+			WideCharToMultiByte( CP_UTF8, 0, pwch, -1, &str[0], cch, NULL, NULL );
+		return str;
+	}
+
+	std::string WideToUTF8( const std::wstring &wstr ) { return WideToUTF8( wstr.c_str() ); }
+
+	std::wstring UTF8ToWide( const std::string &str )
+	{
+		int cch = MultiByteToWideChar( CP_UTF8, 0, str.c_str(), -1, NULL, 0 );
+		std::wstring wstr( cch > 0 ? cch - 1 : 0, L'\0' );
+		if ( cch > 1 )
+			MultiByteToWideChar( CP_UTF8, 0, str.c_str(), -1, &wstr[0], cch );
+		return wstr;
+	}
+
+	bool BIsUUID( const std::string &str )
+	{
+		if ( str.size() != 36 )
+			return false;
+		for ( size_t i = 0; i < str.size(); ++i )
+		{
+			bool bHyphen = i == 8 || i == 13 || i == 18 || i == 23;
+			if ( bHyphen ? str[i] != '-' : !isxdigit( (unsigned char)str[i] ) )
+				return false;
+		}
+		return true;
+	}
+
+	// Random (version 4) UUID
+	std::string NewUUID()
+	{
+		GUID guid;
+		if ( FAILED( CoCreateGuid( &guid ) ) )
+			return std::string();
+		char rgch[37];
+		sprintf_s( rgch, "%08lx-%04hx-%04hx-%02x%02x-%02x%02x%02x%02x%02x%02x", guid.Data1, guid.Data2, guid.Data3,
+			guid.Data4[0], guid.Data4[1], guid.Data4[2], guid.Data4[3], guid.Data4[4], guid.Data4[5], guid.Data4[6], guid.Data4[7] );
+		return rgch;
+	}
+
+	enum EDeviceIdFile
+	{
+		k_EDeviceIdFile_OK,
+		k_EDeviceIdFile_Missing,
+		k_EDeviceIdFile_Invalid,	// readable, but not a UUID: may be replaced
+		k_EDeviceIdFile_Unreadable,	// could not be read (access denied, held by another program): never replaced
+	};
+
+	// Reads the UUID (lowercase) into *pstrID. A file another program holds open (antivirus, backup)
+	// is retried briefly and is never reported as invalid, so a valid ID is not replaced just
+	// because it could not be read at that moment.
+	EDeviceIdFile ReadDeviceIdFile( const std::wstring &wstrPath, std::string *pstrID, DWORD *pdwError )
+	{
+		HANDLE hFile = INVALID_HANDLE_VALUE;
+		*pdwError = 0;
+		for ( int nTry = 0; nTry < 10 && hFile == INVALID_HANDLE_VALUE; ++nTry )
+		{
+			hFile = CreateFileW( wstrPath.c_str(), GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL, OPEN_EXISTING, 0, NULL );
+			if ( hFile != INVALID_HANDLE_VALUE )
+				break;
+			*pdwError = GetLastError();
+			if ( *pdwError == ERROR_FILE_NOT_FOUND || *pdwError == ERROR_PATH_NOT_FOUND )
+				return k_EDeviceIdFile_Missing;
+			if ( *pdwError != ERROR_SHARING_VIOLATION && *pdwError != ERROR_LOCK_VIOLATION )
+				return k_EDeviceIdFile_Unreadable;
+			Sleep( 50 );
+		}
+		if ( hFile == INVALID_HANDLE_VALUE )
+			return k_EDeviceIdFile_Unreadable;
+		char rgch[64] = {};
+		DWORD cbRead = 0;
+		BOOL bRead = ReadFile( hFile, rgch, sizeof( rgch ) - 1, &cbRead, NULL );
+		if ( !bRead )
+			*pdwError = GetLastError();
+		CloseHandle( hFile );
+		if ( !bRead )
+			return k_EDeviceIdFile_Unreadable;
+		std::string str( rgch, cbRead );
+		str.erase( str.find_last_not_of( " \t\r\n" ) + 1 );
+		str.erase( 0, str.find_first_not_of( " \t\r\n\xEF\xBB\xBF" ) );
+		std::transform( str.begin(), str.end(), str.begin(), []( char ch ) { return (char)tolower( (unsigned char)ch ); } );
+		if ( !BIsUUID( str ) )
+			return k_EDeviceIdFile_Invalid;
+		*pstrID = str;
+		return k_EDeviceIdFile_OK;
+	}
+
+	// Windows path of the Linux per-user data folder when running under Wine / Proton, else empty.
+	// *pstrUnixDir gets the same folder as a Linux path. *pstrDiag tells which checks passed
+	// (logged, for the Steam Deck).
+	std::wstring LinuxDataDirViaWine( std::string *pstrUnixDir, std::string *pstrDiag )
+	{
+		char rgch[1024];
+		HMODULE hNtdll = GetModuleHandleW( L"ntdll.dll" );
+		bool bWineExport = hNtdll && GetProcAddress( hNtdll, "wine_get_version" );
+		DWORD cchPrefix = GetEnvironmentVariableA( "WINEPREFIX", rgch, sizeof( rgch ) );
+		*pstrDiag = std::string( "wine_get_version=" ) + ( bWineExport ? "yes" : "no" ) + " WINEPREFIX=" + ( cchPrefix ? "set" : "unset" );
+		if ( !bWineExport && cchPrefix == 0 )
+			return std::wstring();	// real Windows
+
+		// Linux home. Wine does not pass HOME on to Windows programs (seen on Proton 11), so try
+		// what it does pass: its own WINEHOMEDIR ("\??\Z:\home\deck"), then WINEPREFIX
+		// (".../home/deck/.local/share/Steam/steamapps/compatdata/<id>/pfx/"), then USER.
+		auto envUnixPath = [&rgch]( const char *pchName ) -> std::string
+		{
+			DWORD cch = GetEnvironmentVariableA( pchName, rgch, sizeof( rgch ) );
+			return cch > 0 && cch < sizeof( rgch ) && rgch[0] == '/' ? std::string( rgch ) : std::string();
+		};
+		std::string strUnixDir = envUnixPath( "XDG_DATA_HOME" );
+		std::string strHome = strUnixDir.empty() ? envUnixPath( "HOME" ) : std::string();
+		const char *pchHomeFrom = "HOME";
+		if ( strUnixDir.empty() && strHome.empty() )
+		{
+			DWORD cch = GetEnvironmentVariableA( "WINEHOMEDIR", rgch, sizeof( rgch ) );
+			std::string str = cch > 0 && cch < sizeof( rgch ) ? rgch : "";
+			size_t nZ = str.find( "Z:\\" );
+			if ( nZ == std::string::npos )
+				nZ = str.find( "z:\\" );
+			if ( nZ != std::string::npos )
+			{
+				strHome = str.substr( nZ + 2 );
+				std::replace( strHome.begin(), strHome.end(), '\\', '/' );
+				pchHomeFrom = "WINEHOMEDIR";
+			}
+		}
+		if ( strUnixDir.empty() && strHome.empty() )
+		{
+			std::string strPrefix = envUnixPath( "WINEPREFIX" );
+			size_t nShare = strPrefix.find( "/.local/share/" );
+			if ( nShare != std::string::npos && nShare > 0 )
+			{
+				strHome = strPrefix.substr( 0, nShare );
+				pchHomeFrom = "WINEPREFIX";
+			}
+		}
+		if ( strUnixDir.empty() && strHome.empty() )
+		{
+			DWORD cch = GetEnvironmentVariableA( "USER", rgch, sizeof( rgch ) );
+			if ( cch > 0 && cch < sizeof( rgch ) && !strchr( rgch, '/' ) )
+			{
+				strHome = std::string( "/home/" ) + rgch;
+				pchHomeFrom = "USER";
+			}
+		}
+		if ( strUnixDir.empty() )
+		{
+			if ( strHome.empty() )
+			{
+				*pstrDiag += " home=(not found)";
+				return std::wstring();
+			}
+			*pstrDiag += std::string( " home=" ) + strHome + " (from " + pchHomeFrom + ")";
+			strUnixDir = strHome + "/.local/share";
+		}
+		else
+			*pstrDiag += " XDG_DATA_HOME=" + strUnixDir;
+		*pstrUnixDir = strUnixDir;
+
+		typedef WCHAR *( CDECL *PFNWineGetDosFileName )( LPCSTR );
+		PFNWineGetDosFileName pfnToDos = (PFNWineGetDosFileName)GetProcAddress( GetModuleHandleW( L"kernel32.dll" ), "wine_get_dos_file_name" );
+		// Uses whatever drive letter this prefix maps the folder to (Proton maps Z: to /, but that can
+		// be changed), or \\?\unix\... when no drive covers it.
+		if ( WCHAR *pwchDos = pfnToDos ? pfnToDos( strUnixDir.c_str() ) : NULL )	// e.g. \\?\Z:\home\deck\.local\share
+		{
+			std::wstring wstrDir = pwchDos;
+			HeapFree( GetProcessHeap(), 0, pwchDos );
+			if ( wstrDir.size() > 6 && wstrDir.compare( 0, 4, L"\\\\?\\" ) == 0 && wstrDir[5] == L':' )
+				wstrDir.erase( 0, 4 );	// plain drive path; \\?\unix\... is kept as is
+			*pstrDiag += " path=wine_get_dos_file_name";
+			return wstrDir;
+		}
+
+		// Wine's own name for a Linux path, independent of drive letters
+		std::string strDos = "\\\\?\\unix" + strUnixDir;
+		std::replace( strDos.begin(), strDos.end(), '/', '\\' );
+		*pstrDiag += std::string( " path=\\\\?\\unix (wine_get_dos_file_name " ) + ( pfnToDos ? "failed" : "missing" ) + ")";
+		return UTF8ToWide( strDos );
+	}
+
+	struct DeviceIdResult_t
+	{
+		std::string m_strID;		// empty on failure
+		std::string m_strInfo;
+		std::wstring m_wstrPath;
+		std::string m_strShownPath;	// Linux path under Wine / Proton, else the Windows path
+		std::string m_strDiag;
+	};
+
+	// Creates the folder and any missing parents. Works with \\?\ paths (SHCreateDirectoryExW does not).
+	bool CreateDirectoryTree( const std::wstring &wstrDir )
+	{
+		if ( CreateDirectoryW( wstrDir.c_str(), NULL ) || GetLastError() == ERROR_ALREADY_EXISTS )
+			return true;
+		if ( GetLastError() != ERROR_PATH_NOT_FOUND )
+			return false;
+		size_t nSlash = wstrDir.find_last_of( L'\\' );
+		if ( nSlash == std::wstring::npos || nSlash == 0 || !CreateDirectoryTree( wstrDir.substr( 0, nSlash ) ) )
+			return false;
+		return CreateDirectoryW( wstrDir.c_str(), NULL ) || GetLastError() == ERROR_ALREADY_EXISTS;
+	}
+
+	DeviceIdResult_t LoadOrCreateDeviceId()
+	{
+		DeviceIdResult_t result;
+		const char *pchWhere = "Linux home via Wine/Proton";
+		std::string strUnixDir;
+		std::wstring wstrDir = LinuxDataDirViaWine( &strUnixDir, &result.m_strDiag );
+		if ( wstrDir.empty() )
+		{
+			pchWhere = "LocalAppData";
+			PWSTR pwchLocalAppData = NULL;
+			if ( SUCCEEDED( SHGetKnownFolderPath( FOLDERID_LocalAppData, 0, NULL, &pwchLocalAppData ) ) )
+				wstrDir = pwchLocalAppData;
+			CoTaskMemFree( pwchLocalAppData );
+		}
+		if ( wstrDir.empty() )
+		{
+			result.m_strInfo = "FAILED: no folder to store it in";
+			return result;
+		}
+		wstrDir = wstrDir + L"\\" + k_pwchDeviceIdFolder;
+		result.m_wstrPath = wstrDir + L"\\" + k_pwchDeviceIdFile;
+		result.m_strShownPath = strUnixDir.empty() ? WideToUTF8( result.m_wstrPath )
+			: strUnixDir + "/" + WideToUTF8( k_pwchDeviceIdFolder ) + "/" + WideToUTF8( k_pwchDeviceIdFile );
+
+		// 1. Already there: return it. Could not be read: give up rather than replace it
+		DWORD dwError = 0;
+		EDeviceIdFile eFile = ReadDeviceIdFile( result.m_wstrPath, &result.m_strID, &dwError );
+		if ( eFile == k_EDeviceIdFile_OK )
+		{
+			result.m_strInfo = std::string( "existing, " ) + pchWhere;
+			return result;
+		}
+		if ( eFile == k_EDeviceIdFile_Unreadable )
+		{
+			result.m_strInfo = "FAILED to read the existing file (error " + std::to_string( dwError ) + "), " + pchWhere;
+			return result;
+		}
+
+		// 2. Create it: write a temp file, then move it into place
+		bool bReplace = eFile == k_EDeviceIdFile_Invalid;
+		if ( !CreateDirectoryTree( wstrDir ) )
+		{
+			result.m_strInfo = "FAILED to create the folder (error " + std::to_string( GetLastError() ) + "), " + pchWhere;
+			return result;
+		}
+		std::string strNew = NewUUID();
+		if ( strNew.empty() )
+		{
+			result.m_strInfo = std::string( "FAILED to generate a UUID, " ) + pchWhere;
+			return result;
+		}
+		std::wstring wstrTemp = result.m_wstrPath + L"." + std::to_wstring( GetCurrentProcessId() ) + L".tmp";
+		HANDLE hFile = CreateFileW( wstrTemp.c_str(), GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL );
+		DWORD cbWritten = 0;
+		bool bWritten = hFile != INVALID_HANDLE_VALUE &&
+			WriteFile( hFile, strNew.c_str(), (DWORD)strNew.size(), &cbWritten, NULL ) && cbWritten == strNew.size() &&
+			FlushFileBuffers( hFile );
+		if ( !bWritten )
+			dwError = GetLastError();
+		if ( hFile != INVALID_HANDLE_VALUE )
+			CloseHandle( hFile );
+		bool bMoved = bWritten && MoveFileExW( wstrTemp.c_str(), result.m_wstrPath.c_str(), bReplace ? MOVEFILE_REPLACE_EXISTING : 0 );
+		if ( bWritten && !bMoved )
+			dwError = GetLastError();
+		DeleteFileW( wstrTemp.c_str() );	// already gone after a move
+
+		// Return what is on disk: another game may have created it first, or (when two games replace an
+		// invalid file at once) moved its own over ours. Both then use the same ID.
+		std::string strOnDisk;
+		DWORD dwReadError = 0;
+		if ( ReadDeviceIdFile( result.m_wstrPath, &strOnDisk, &dwReadError ) == k_EDeviceIdFile_OK )
+		{
+			result.m_strID = strOnDisk;
+			if ( !bMoved || strOnDisk != strNew )
+				result.m_strInfo = std::string( "existing (created by another process just now), " ) + pchWhere;
+			else
+				result.m_strInfo = std::string( bReplace ? "created (replaced an invalid file), " : "created, " ) + pchWhere;
+		}
+		else
+			result.m_strInfo = "FAILED to write (error " + std::to_string( dwError ? dwError : dwReadError ) + "), " + pchWhere;
+		return result;
+	}
+}
+#endif
