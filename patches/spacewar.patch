+void COverlayExamples::InitBridge()
+{
+#ifdef _WIN32
+	m_strOvbURL = ReadFirstLine( k_pchOvbURLFile, k_pchOvbDefaultURL );
+
+	if ( !OVB_LoadApi( &g_Ovb, NULL ) )
+	{
+		m_strOvbStatus = "OFF: overlay_bridge.dll not found";
+		LogBrowserTest( "[OVB] %s", m_strOvbStatus.c_str() );
+		return;
+	}
+	OVB_Config config = {};
+	config.structSize = sizeof( config );
+	config.allowedOrigins = k_rgpchOvbOrigins;
+	config.allowedOriginCount = sizeof( k_rgpchOvbOrigins ) / sizeof( k_rgpchOvbOrigins[0] );
+	config.onMessage = OnOvbMessage;
+	config.onClosed = OnOvbClosed;
+	config.onOpened = OnOvbOpened;
+	config.user = this;
+	int nRC = g_Ovb.OVB_Init( &config );
+	g_bOvbReady = nRC == OVB_BRIDGE_OK;
+	m_strOvbStatus = g_bOvbReady ? "ready" : "OFF: OVB_Init failed (" + std::to_string( nRC ) + ")";
+	LogBrowserTest( "[OVB] DLL loaded, OVB_Init -> %d (main thread %lu)", nRC, GetCurrentThreadId() );
+#endif
+}
