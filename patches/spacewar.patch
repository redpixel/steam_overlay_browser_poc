+//-----------------------------------------------------------------------------
+// Purpose: Overlay browser open/close detection test
+//
+// The Steam API has no "browser closed" callback. What it does give us is
+// GameOverlayActivated_t, which fires when the overlay takes / releases input focus.
+//
+//  - Modal mode:   the browser is the only thing shown in the overlay, and closing the
+//                  browser closes the overlay (and vice versa). So
+//                  GameOverlayActivated_t( m_bActive = false ) == browser closed.
+//  - Default mode: the browser is just another overlay window and stays open after the
+//                  overlay is hidden, so the same event only means "overlay hidden".
+//
+// In modal mode a page can also report back by navigating to spacewar://..., which
+// arrives as OverlayBrowserProtocolNavigation_t.
+//-----------------------------------------------------------------------------
+void COverlayExamples::StartBrowserTest( const char *pchURL, EActivateGameOverlayToWebPageMode eMode )
+{
+	if ( m_eBrowserTestState == k_EBrowserTestState_WaitingForOpen || m_eBrowserTestState == k_EBrowserTestState_Open )
+	{
+		LogBrowserTest( "Ignoring open request, browser test already in progress" );
+		return;
+	}
+
+	if ( !SteamUtils()->IsOverlayEnabled() )
+	{
+		// Not fatal: the overlay can still be injecting right after launch, so try anyway.
+		LogBrowserTest( "WARNING: SteamUtils()->IsOverlayEnabled() is false" );
+	}
+
+	if ( eMode == k_EActivateGameOverlayToWebPageMode_Modal )
+	{
+		bool bRegistered = SteamFriends()->RegisterProtocolInOverlayBrowser( k_pchBrowserTestProtocol );
+		LogBrowserTest( "RegisterProtocolInOverlayBrowser( \"%s\" ) -> %s", k_pchBrowserTestProtocol, bRegistered ? "true" : "false" );
+	}
+
+	m_eBrowserTestMode = eMode;
+	m_eBrowserTestState = k_EBrowserTestState_WaitingForOpen;
+	m_ulBrowserTestRequestTick = m_pGameEngine->GetGameTickCount();
+	m_ulBrowserTestOpenTick = 0;
+	m_ulBrowserTestCloseTick = 0;
+	m_bBrowserTestClosedByUser = false;
+	m_strBrowserTestLastProtocolURI.clear();
+
+	LogBrowserTest( "ActivateGameOverlayToWebPage( \"%s\", %s )", pchURL,
+		eMode == k_EActivateGameOverlayToWebPageMode_Modal ? "Modal" : "Default" );
+	SteamFriends()->ActivateGameOverlayToWebPage( pchURL, eMode );
+}
