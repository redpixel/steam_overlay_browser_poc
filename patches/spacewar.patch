+//-----------------------------------------------------------------------------
+// Purpose: Changes the test URL and remembers it in overlay_test_url.txt
+//-----------------------------------------------------------------------------
+void COverlayExamples::SetBrowserTestURL( const std::string &strURL )
+{
+	std::string strTrimmed = strURL;
+	strTrimmed.erase( strTrimmed.find_last_not_of( " \t\r\n" ) + 1 );
+	strTrimmed.erase( 0, strTrimmed.find_first_not_of( " \t\r\n" ) );
+	if ( strTrimmed.empty() )
+	{
+		LogBrowserTest( "Ignoring empty URL" );
+		return;
+	}
+
+	m_strBrowserTestURL = strTrimmed;
+	LogBrowserTest( "Browser test URL set to: %s", m_strBrowserTestURL.c_str() );
+
+	if ( FILE *file = fopen( k_pchBrowserTestURLFile, "wt" ) )
+	{
+		fprintf( file, "%s\n", m_strBrowserTestURL.c_str() );
+		fclose( file );
+	}
+
+	m_pMenu->Rebuild();
+}
